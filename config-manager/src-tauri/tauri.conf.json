{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DS5 Dongle Config",
  "version": "0.0.14",
  "identifier": "local.ds5.bridge.config",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS5 Dongle Config",
        "width": 1005,
        "height": 675,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "config/device.toml"
    ]
  }
}
