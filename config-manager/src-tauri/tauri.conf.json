{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DS5 Bridge Config",
  "version": "0.1.0",
  "identifier": "local.ds5.bridge.config",
  "build": {
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS5 Bridge Config",
        "width": 980,
        "height": 635,
        "minWidth": 780,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "config/device.toml"
    ]
  }
}
